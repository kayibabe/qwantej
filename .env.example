# API-Football — direct (dashboard.api-football.com)
API_FOOTBALL_KEY=your_api_football_key_here

# API-Football via RapidAPI (api-football-v1.p.rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# Set to "direct" or "rapidapi"
API_FOOTBALL_HOST=direct

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://qwantej:qwantej_pass@localhost:5432/qwantej
# Required by docker-compose.prod.yml: initializes Postgres and builds its
# DATABASE_URL. Use a unique password in production.
POSTGRES_USER=qwantej
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=qwantej

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
# Comma-separated proxy IPs/CIDRs Uvicorn may trust for X-Forwarded-For.
# Keep 127.0.0.1 for a host reverse proxy; set the proxy subnet for containers.
FORWARDED_ALLOW_IPS=127.0.0.1
SECRET_KEY=change_me_in_production
# Required for state-changing research API calls outside local development.
RESEARCH_API_KEY=replace_with_a_long_random_value
# Separate administrator key for admin automation. Do not reuse RESEARCH_API_KEY:
# research access must not grant account administration.
ADMIN_API_KEY=
LOG_LEVEL=INFO

# Browser authentication
AUTH_COOKIE_NAME=qwantej_session
AUTH_SESSION_DAYS=30
AUTH_SESSION_RETENTION_DAYS=7
AUTH_TOKEN_RETENTION_DAYS=7
PASSWORD_RESET_TOKEN_MINUTES=30
EMAIL_VERIFICATION_TOKEN_HOURS=24
AUTH_ALLOW_REGISTRATION=true

# Transactional email for password reset and verification. Leave SMTP_HOST
# empty in development; the one-time link is logged instead of delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Daily session pruning and stale Pro-subscription reconciliation
ACCOUNT_LIFECYCLE_ENABLED=true
ACCOUNT_LIFECYCLE_CRON_HOUR=0
ACCOUNT_LIFECYCLE_CRON_MINUTE=45
PRO_SUBSCRIPTION_PERIOD_DAYS=30
PRO_SUBSCRIPTION_GRACE_DAYS=3

# Pipeline schedule (stored as UTC; displayed as CAT = UTC+2)
PIPELINE_EARLY_CRON_HOUR=22
PIPELINE_EARLY_CRON_MINUTE=15
PIPELINE_MORNING_CRON_HOUR=3
PIPELINE_MORNING_CRON_MINUTE=0
PIPELINE_STARTUP_CATCHUP_ENABLED=true
PIPELINE_WATCHDOG_INTERVAL_MINUTES=5
PIPELINE_STALE_AFTER_MINUTES=45
PIPELINE_AUTOMATIC_RETRY_LIMIT=2

# Automatic result refresh and settlement
SETTLEMENT_INTERVAL_MINUTES=10
SETTLEMENT_LOOKBACK_DAYS=7
SETTLEMENT_STARTUP_LOOKBACK_DAYS=30
SCHEDULER_LEADER_LOCK_ENABLED=true
SCHEDULER_LEADER_LOCK_NAME=qwantej:apscheduler:leader

# Weekly no-lookahead shadow learning (never auto-promotes)
LEARNING_SHADOW_SCHEDULE_ENABLED=true

# "analytical" (default): fast, deterministic MAP estimate — matters for the
# backtester's reproducibility guarantee. "advi": real PyMC variational
# inference, much slower and not bit-for-bit reproducible run to run.
BAYESIAN_ESTIMATION_METHOD=analytical

# Optional hosted Pro checkout. Create a matching MWK 20,000 monthly
# Flutterwave payment plan and configure these values before enabling checkout.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_PRO_MONTHLY_PLAN_ID=
FLUTTERWAVE_PRO_MONTHLY_PRICE_MWK=20000
PUBLIC_APP_BASE_URL=

# Frozen prospective paper experiment (opt in locally).
SWEET_SPOT_TRACKING_ENABLED=false
# Frozen prospective paper rules: goals overs, home win, band-mix disagreements (opt in locally).
PAPER_RULES_TRACKING_ENABLED=false
