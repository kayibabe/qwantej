# Copy to .env and fill in real values. Never commit .env.
# Keep this file in sync with every new required variable (see DEVELOPMENT.md).

# --- Backend / Database ---
ENVIRONMENT=development
# Points at the containerised dev database from docker-compose.yml, which
# publishes on host port 5433 to stay clear of any native Postgres on 5432.
# `docker compose up -d db`, then `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://qwantej:password@localhost:5433/qwantej
SECRET_KEY=change-me

# --- Data sources ---
API_FOOTBALL_KEY=

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
