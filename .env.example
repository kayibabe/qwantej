# Copy to .env and fill in real values. Never commit .env.
# Keep this file in sync with every new required variable (see DEVELOPMENT.md).

# --- Backend / Database ---
ENVIRONMENT=development
# Points at the containerised dev database from docker-compose.yml, which
# publishes on host port 5433 to stay clear of any native Postgres on 5432.
# `docker compose up -d db`, then `alembic upgrade head`.
# In production (Railway), this is the Neon pooled connection string instead,
# e.g. postgresql+psycopg://user:pass@ep-xxx-pooler.region.aws.neon.tech/qwantej?sslmode=require
DATABASE_URL=postgresql+psycopg://qwantej:password@localhost:5433/qwantej
SECRET_KEY=change-me

# --- Data sources ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TIMEOUT_SECONDS=30
# Research-only broad coverage. This pulls all current-season leagues at the
# scheduler's quota-safe interval but never permits an unvalidated league to
# produce public predictions or paper tickets.
INGEST_ALL_LEAGUES=false
# Run approved-league forecasts and accumulator construction. Every resulting
# ticket remains paper-only; false keeps the scheduler in shadow collection.
PAPER_TICKET_PIPELINE_ENABLED=false

# --- Security ---
# Empty string disables API key auth. Only allowed when ENVIRONMENT=development
# — any other value requires this to be set, or the app refuses to start.
API_KEY=

# --- CORS ---
# Comma-separated origins allowed to call the API (e.g. the qwantej-frontend
# Railway service's URL). Required whenever ENVIRONMENT is not "development"
# — the app refuses to start otherwise. Ignored only in development, where
# all origins are allowed for local convenience.
CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=plain   # set to "json" in production

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# --- Backups ---
BACKUP_DIR=backups
BACKUP_KEEP_COUNT=7

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
