# Copy to .env and fill in real values. Never commit .env.
# Keep this file in sync with every new required variable (see DEVELOPMENT.md).

# --- Backend / Database ---
ENVIRONMENT=development
# Points at the containerised dev database from docker-compose.yml, which
# publishes on host port 5433 to stay clear of any native Postgres on 5432.
# `docker compose up -d db`, then `alembic upgrade head`.
# In production (Railway), this is set via a Railway variable reference to
# the `Postgres` service in the same project instead, e.g.
# postgresql+psycopg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_URL=postgresql+psycopg://qwantej:password@localhost:5433/qwantej
SECRET_KEY=change-me

# --- Data sources ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_TIMEOUT_SECONDS=30

# --- Security ---
# Empty string disables API key auth (safe for local dev; set in production).
API_KEY=

# --- CORS ---
# Comma-separated origins allowed to call the API when ENVIRONMENT=production
# (e.g. the qwantej-frontend Railway service's URL). Ignored outside
# production, where all origins are allowed for local/dev convenience.
CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=plain   # set to "json" in production

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=10

# --- Backups ---
BACKUP_DIR=backups
BACKUP_KEEP_COUNT=7

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
